---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';

const email = 'tim@timothymarias.com';

const channels = [
	{ label: 'Email', copy: true },
	{ label: 'GitHub', value: 'timothyjamesmarias', href: 'https://github.com/timothyjamesmarias' },
	{ label: 'Location', value: 'Oregon' },
];
---

<BaseLayout
	title="Contact"
	description="Get in touch with Timothy Marias — full stack software developer."
	image="/og/contact.png"
>
	<div
		class="grid grid-cols-1 gap-x-8 gap-y-8 px-6 pt-16 pb-14 md:grid-cols-[96px_1fr] md:px-18"
	>
		{/* Standalone page, so no section number — that sequence is the home page's. */}
		<span class="eyebrow pt-2">Contact</span>

		<div>
			<h1
				class="max-w-[620px] text-[2rem] leading-title font-bold tracking-display text-pretty sm:text-title"
			>
				Get in touch.
			</h1>
			<p class="mt-5 max-w-[460px] text-[0.9375rem] leading-normal text-ink-muted">
				Email is the best way to reach me.
			</p>

			<dl class="mt-10 max-w-[460px]">
				{
					channels.map((channel, i) => (
						<div
							class:list={[
								'flex justify-between gap-6 py-3 text-caption',
								i === 0
									? 'border-t border-rule-strong'
									: 'border-t border-rule',
							]}
						>
							<dt class="text-mini tracking-widest text-ink-faint uppercase">
								{channel.label}
							</dt>
							<dd class="text-ink">
								{channel.copy ? (
									<CopyEmail email={email} />
								) : channel.href ? (
									<a href={channel.href} class="link">
										{channel.value}
									</a>
								) : (
									channel.value
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</BaseLayout>
