---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';

export const getStaticPaths: GetStaticPaths = async () => {
	// Drafts get a page in dev so they can be previewed, but never build into
	// production. Listings filter drafts out in both, so they stay unlinked.
	const posts = (
		await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV)
	).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			// Sorted newest-first, so the next-older post sits at i + 1.
			newer: posts[i - 1] ?? null,
			older: posts[i + 1] ?? null,
		},
	}));
};

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const stamp = (date: Date) =>
	date
		.toLocaleDateString('en-GB', {
			year: '2-digit',
			month: '2-digit',
			day: '2-digit',
			timeZone: 'UTC',
		})
		.split('/')
		.reverse()
		.join('.');

// h1 is the post title, rendered separately; h4 and below are too granular to
// navigate by. h3 is indented under its parent h2.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	...(post.data.updatedDate && {
		dateModified: post.data.updatedDate.toISOString(),
	}),
	author: {
		'@type': 'Person',
		name: 'Timothy Marias',
		url: 'https://timothymarias.com',
	},
	keywords: post.data.tags,
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	type="article"
	publishedTime={post.data.pubDate}
	modifiedTime={post.data.updatedDate}
	image={`/og/blog/${post.id}.png`}
	schema={schema}
>
	<article>
		<div
			class="grid grid-cols-1 gap-y-8 px-6 pt-16 pb-12 md:grid-cols-[96px_1fr] md:gap-x-8 md:px-18 lg:grid-cols-[96px_1fr_300px]"
		>
			<div class="eyebrow pt-2 font-mono">
				<time datetime={post.data.pubDate.toISOString()}>
					{stamp(post.data.pubDate)}
				</time>
			</div>

			<div>
				<h1
					class="max-w-[620px] text-[2rem] leading-title font-bold tracking-display text-pretty sm:text-title"
				>
					{post.data.title}
				</h1>
				{
					post.data.tags.length > 0 && (
						<div class="mt-4 flex flex-wrap gap-2">
							{post.data.tags.map((tag) => (
								<span class="border border-rule px-2.5 py-1 text-micro tracking-wider text-ink-muted uppercase">
									{tag}
								</span>
							))}
						</div>
					)
				}
			</div>

		</div>

		{/*
			The ToC sits in this grid rather than the header's so it can stick for
			the length of the article — sticky only tracks within its own
			containing block, and the header grid ends before the body begins.
			`items-start` keeps the aside from stretching to the row height, which
			would leave it nothing to travel through.
		*/}
		<div
			class="grid grid-cols-1 items-start px-6 md:grid-cols-[96px_1fr] md:gap-x-8 md:px-18 lg:grid-cols-[96px_1fr_300px]"
		>
			<div></div>
			<Prose>
				<Content />
			</Prose>

			{
				toc.length > 0 && (
					<aside class="sticky top-8 hidden max-h-[calc(100vh-4rem)] overflow-y-auto lg:block">
						<div class="eyebrow">Contents</div>
						<nav aria-label="Table of contents" class="mt-4 flex flex-col gap-2">
							{toc.map((heading) => (
								<a
									href={`#${heading.slug}`}
									class:list={[
										'text-caption leading-snug no-underline transition-colors hover:text-accent',
										heading.depth === 3 ? 'pl-3 text-ink-faint' : 'text-ink-muted',
									]}
								>
									{heading.text}
								</a>
							))}
						</nav>
					</aside>
				)
			}
		</div>

		{
			(newer || older) && (
				<nav
					aria-label="Post navigation"
					class="mt-20 grid grid-cols-1 gap-6 border-t border-rule px-6 pt-8 sm:grid-cols-2 md:px-18"
				>
					<div>
						{older && (
							<a href={`/blog/${older.id}/`} class="group no-underline">
								<span class="eyebrow block">Previous</span>
								<span class="mt-2 block text-small leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
									&larr; {older.data.title}
								</span>
							</a>
						)}
					</div>
					<div class="sm:text-right">
						{newer && (
							<a href={`/blog/${newer.id}/`} class="group no-underline">
								<span class="eyebrow block">Next</span>
								<span class="mt-2 block text-small leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
									{newer.data.title} &rarr;
								</span>
							</a>
						)}
					</div>
				</nav>
			)
		}
	</article>
</BaseLayout>
