---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const stamp = (date: Date) =>
	date
		.toLocaleDateString('en-GB', {
			year: '2-digit',
			month: '2-digit',
			day: '2-digit',
			timeZone: 'UTC',
		})
		.split('/')
		.reverse()
		.join('.');
---

<BaseLayout
	title="Notes"
	description="Writing by Timothy Marias."
	image="/og/blog.png"
>
	<section class="px-6 pt-16 md:px-18">
		<h1 class="eyebrow">02 / Notes</h1>

		{
			posts.length === 0 ? (
				<p class="mt-8 text-body text-ink-muted">Nothing published yet.</p>
			) : (
				<ul class="mt-8 border-t border-rule">
					{posts.map((post) => (
						<li class="border-b border-rule">
							<a
								href={`/blog/${post.id}/`}
								class="group grid grid-cols-1 gap-x-8 gap-y-2 py-6 no-underline md:grid-cols-[96px_1fr]"
							>
								<time
									datetime={post.data.pubDate.toISOString()}
									class="eyebrow pt-1 font-mono"
								>
									{stamp(post.data.pubDate)}
								</time>
								<div>
									<h2 class="max-w-[620px] text-lead leading-snug font-bold tracking-tight text-ink transition-colors group-hover:text-accent text-pretty">
										{post.data.title}
									</h2>
									<p class="mt-2 max-w-[620px] text-small leading-normal text-ink-muted">
										{post.data.description}
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>
