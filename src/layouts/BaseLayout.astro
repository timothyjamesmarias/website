---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SiteMeta from '../components/SiteMeta.astro';

interface Props {
	title: string;
	description?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	image?: string;
	/** Structured data for this page, serialised into a JSON-LD script. */
	schema?: Record<string, unknown>;
}

const { schema, ...meta } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<SiteMeta {...meta} />
		{
			schema && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(schema)}
				/>
			)
		}
		<ThemeScript />
	</head>
	<body class="bg-page text-ink">
		<div class="mx-auto flex min-h-screen max-w-[1280px] flex-col">
			<header>
				<SiteHeader />
			</header>
			{/* Absorbs the slack on short pages so the footer never floats
			    mid-viewport, while still scrolling normally on long ones. */}
			<main class="flex-1">
				<slot />
			</main>
			<footer>
				<SiteFooter />
			</footer>
		</div>
	</body>
</html>
