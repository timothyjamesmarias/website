<div class="prose">
	<slot />
</div>

<style>
	/* Rendered markdown has no classes to target, so the design lives here as
	   element selectors scoped to .prose. */
	.prose {
		max-width: var(--measure);
		font-size: var(--text-body);
		line-height: var(--leading-prose);
		color: var(--color-ink);
		text-wrap: pretty;
		/* A bare URL or long identifier is one unbreakable token; without this
		   it widens the grid track and takes the whole page horizontal. */
		overflow-wrap: anywhere;
	}

	/* The usual offenders, stated outright — `anywhere` above only applies
	   where the browser has no other break opportunity. */
	.prose :global(a),
	.prose :global(code) {
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.prose :global(> * + *) {
		margin-top: 1.5em;
	}

	.prose :global(h2),
	.prose :global(h3) {
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-snug);
		text-wrap: balance;
	}

	.prose :global(h2) {
		margin-top: 2.5em;
		font-size: var(--text-lead);
	}

	.prose :global(h3) {
		margin-top: 2em;
		font-size: var(--text-body);
	}

	.prose :global(a) {
		color: var(--color-ink);
		text-decoration-line: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: color 0.15s;
	}

	.prose :global(a:hover) {
		color: var(--color-accent);
	}

	.prose :global(strong) {
		font-weight: 600;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25em;
	}

	.prose :global(ul) {
		list-style: none;
	}

	/* Square markers echo the header wordmark. */
	.prose :global(ul > li) {
		position: relative;
	}

	.prose :global(ul > li::before) {
		content: '';
		position: absolute;
		left: -1.05em;
		top: 0.62em;
		width: 4px;
		height: 4px;
		background: var(--color-accent);
	}

	.prose :global(ol) {
		list-style: decimal;
	}

	.prose :global(li + li) {
		margin-top: 0.5em;
	}

	.prose :global(li::marker) {
		color: var(--color-ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.prose :global(blockquote) {
		border-left: 2px solid var(--color-accent);
		padding-left: 1.25em;
		font-size: var(--text-lead);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		color: var(--color-ink-muted);
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.875em;
		background: var(--color-surface-sunken);
		padding: 0.1em 0.25em;
		color: var(--color-ink);
	}

	.prose :global(pre) {
		background: var(--color-surface-sunken) !important;
		border: 1px solid var(--color-rule);
		padding: 1.25rem;
		overflow-x: auto;
		font-size: var(--text-small);
		line-height: var(--leading-normal);
	}

	.prose :global(pre code) {
		background: none;
		padding: 0;
		font-size: inherit;
	}

	/* Shiki emits both palettes as custom properties; swap which one the
	   tokens read from when the dark theme is active. */
	:global(:root[data-theme='dark']) .prose :global(.astro-code),
	:global(:root[data-theme='dark']) .prose :global(.astro-code span) {
		color: var(--shiki-dark) !important;
		font-style: var(--shiki-dark-font-style) !important;
		font-weight: var(--shiki-dark-font-weight) !important;
		text-decoration: var(--shiki-dark-text-decoration) !important;
	}

	/* Diagrams are rendered to SVG at build time. Mermaid bakes its palette in
	   as inline attributes, so the theme has to be reasserted here — otherwise
	   a diagram keeps light-mode colors against the dark page. */
	.prose :global(figure.mermaid) {
		margin-top: 2em;
		overflow-x: auto;
	}

	.prose :global(figure.mermaid svg) {
		max-width: 100%;
		height: auto;
		font-family: var(--font-sans) !important;
	}

	.prose :global(figure.mermaid .nodeLabel),
	.prose :global(figure.mermaid .edgeLabel),
	.prose :global(figure.mermaid .label),
	.prose :global(figure.mermaid text) {
		fill: var(--color-ink) !important;
		color: var(--color-ink) !important;
		font-family: var(--font-sans) !important;
	}

	.prose :global(figure.mermaid .node rect),
	.prose :global(figure.mermaid .node circle),
	.prose :global(figure.mermaid .node polygon),
	.prose :global(figure.mermaid .node path) {
		fill: var(--color-surface-sunken) !important;
		stroke: var(--color-rule) !important;
	}

	/* Flowchart edges are .flowchart-link; sequence diagrams use .messageLine*
	   and plain <line> for lifelines. */
	.prose :global(figure.mermaid .flowchart-link),
	.prose :global(figure.mermaid .messageLine0),
	.prose :global(figure.mermaid .messageLine1),
	.prose :global(figure.mermaid line) {
		stroke: var(--color-ink-faint) !important;
	}

	.prose :global(figure.mermaid .arrowMarkerPath),
	.prose :global(figure.mermaid marker path) {
		fill: var(--color-ink-faint) !important;
		stroke: var(--color-ink-faint) !important;
	}

	/* Edge labels sit on an opaque plate that would otherwise stay white. */
	.prose :global(figure.mermaid .edgeLabel rect),
	.prose :global(figure.mermaid .labelBkg) {
		fill: var(--color-page) !important;
		background: var(--color-page) !important;
		opacity: 1 !important;
	}

	.prose :global(hr) {
		border: 0;
		border-top: 1px solid var(--color-rule);
		margin-top: 3em;
		margin-bottom: 3em;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	/* Tables can't wrap, so a wide one scrolls in its own box rather than
	   widening the page. Markdown emits a bare <table> with no wrapper, so the
	   scroll container has to be the table itself. */
	.prose :global(table) {
		display: block;
		width: 100%;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: var(--text-small);
	}

	/* display:block drops the table's own shrink-wrapping, so cells need to be
	   told not to wrap or every column collapses to its narrowest word. */
	.prose :global(th),
	.prose :global(td) {
		white-space: nowrap;
	}

	.prose :global(th) {
		text-align: left;
		font-size: var(--text-mini);
		letter-spacing: var(--tracking-widest);
		text-transform: uppercase;
		color: var(--color-ink-faint);
		font-weight: 500;
	}

	.prose :global(th),
	.prose :global(td) {
		border-bottom: 1px solid var(--color-rule);
		padding: 0.6em 0.75em 0.6em 0;
	}
</style>
