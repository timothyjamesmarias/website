---
export interface ProjectLink {
	/** Short label — "Repo", "Live", "Docs". */
	label: string;
	href: string;
}

interface Props {
	index: string;
	title: string;
	summary: string;
	/** Stack or domain. */
	tags?: string[];
	/** Single year, or a range for things with duration worth showing. */
	year: string;
	/** Zero or more destinations. Nothing linkable renders as "Private". */
	links?: ProjectLink[];
	/** The first row carries the heavier rule, matching the design. */
	first?: boolean;
}

const {
	index,
	title,
	summary,
	tags = [],
	year,
	links = [],
	first = false,
} = Astro.props;

// External links get the arrow and a new tab; internal ones stay in place.
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{/*
	A div, not an anchor: rows can carry several destinations now, and links
	can't nest. The links in the last column are the only click targets.
*/}
<div
	class:list={[
		/*
			Three layouts, not two. Below sm everything stacks. From sm to lg the
			title spans both content columns and tags/meta sit side by side
			beneath it — without that middle step they collide in one column.
			At lg the design's four-column row takes over.
		*/
		'grid grid-cols-1 items-baseline gap-x-6 gap-y-2 py-[18px]',
		'sm:grid-cols-[40px_1fr_auto] lg:grid-cols-[40px_1fr_190px_200px]',
		first ? 'border-t border-rule-strong' : 'border-t border-rule',
	]}
>
	<span class="eyebrow font-mono">{index}</span>

	{/* Spans tags + meta between sm and lg; back to one column at lg. */}
	<div class="sm:col-span-2 lg:col-span-1">
		<h3 class="text-[1.125rem] font-bold tracking-tight text-ink">
			{title}
		</h3>
		<p class="mt-[5px] max-w-[420px] text-small leading-normal text-ink-muted">
			{summary}
		</p>
	</div>

	{/* Starts a fresh row under the title until the lg layout has a slot for it. */}
	<div class="flex flex-wrap gap-1.5 sm:col-start-2 lg:col-start-auto">
		{
			tags.map((tag) => (
				<span class="border border-rule px-[7px] py-[3px] text-micro tracking-wide text-ink-muted uppercase">
					{tag}
				</span>
			))
		}
	</div>

	<div class="flex flex-col gap-2.5 lg:items-end">
		<span class="text-mini text-ink-faint">{year}</span>
		{
			links.length > 0 ? (
				<div class="flex flex-wrap gap-3.5">
					{links.map((link) => (
						<a
							href={link.href}
							target={isExternal(link.href) ? '_blank' : undefined}
							rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
							class="flex items-baseline gap-[5px] border-b border-ink pb-[3px] text-micro tracking-wider text-ink uppercase no-underline transition-colors hover:border-accent hover:text-accent"
						>
							<span>{link.label}</span>
							{isExternal(link.href) && (
								<span class="text-accent">&#8599;</span>
							)}
						</a>
					))}
				</div>
			) : (
				/* Nothing to link to — say so rather than leaving the cell bare. */
				<span class="text-micro tracking-wider text-ink-faint uppercase">
					Private
				</span>
			)
		}
	</div>
</div>